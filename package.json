{
  "name": "jarvic-computer-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "tsc --noEmit",
    "lint:electron": "tsc --noEmit -p electron/tsconfig.json",
    "electron:build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:say --external:playwright --external:@picovoice/pvrecorder-node --outfile=dist-electron/main.cjs",
    "electron:build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "electron:build": "npm run build && npm run electron:build:main && npm run electron:build:preload",
    "electron:dev": "concurrently -k -n SERVER,MAIN,PRELOAD,APP -c blue,green,yellow,magenta \"cross-env NODE_ENV=development tsx server.ts\" \"esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:say --external:playwright --external:@picovoice/pvrecorder-node --outfile=dist-electron/main.cjs --watch\" \"esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs --watch\" \"wait-on tcp:3000 dist-electron/main.cjs dist-electron/preload.cjs && cross-env NODE_ENV=development electron .\"",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "electron:preview": "npm run electron:build && npm run electron:start",
    "dist:win": "npm run electron:build && electron-builder --config electron-builder.yml --win",
    "transcribe": "node transcribe.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@picovoice/pvrecorder-node": "^1.2.9",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "assemblyai": "latest",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "say": "^0.16.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.1"
  }
}
